# Required for matching/enrichment (milestone 2+). https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Optional: Rotten Tomatoes / IMDb / Metacritic scores. http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Optional: LLM re-ranking + explanations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional overrides for anything in backend/app/config.py, e.g.
# MOVIELENS_DATASET=ml-32m
